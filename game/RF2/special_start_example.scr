################################################################################
## MAID EXAMPLE ## IMAGE = 8 Angles // -- [O] Free Movement // [O] Action Points
################################################################################






default flower = None
default flower_collected = []
screen maid_end:
    modal True
    zorder 1
    add Solid("#000000") alpha 0.95
    text "YOU COLLECTED ALL FLOWERS!" size 50 color "#FFFFFF" xalign 0.5 yalign 0.5 yoffset -75
    vbox:
        xalign 0.5 yalign 0.5
        textbutton _("RESTART") text_idle_color "#36A839" text_hover_color "#5AFF49" xalign 0.5 yalign 0.5 action [SetVariable("flower_collected",[]),Hide("maid_end")]
        textbutton _("END") text_idle_color "#36A839" text_hover_color "#5AFF49" xalign 0.5 yalign 0.5 action [MainMenu()]

label maid_label_1:
    $ lock_plyr_cntrl = True
    show screen maid_end
    window hide
    $ lock_plyr_cntrl = False
    $ renpy.pause(modal=False,hard=True)

label maid_flower_collected:
    $ lock_plyr_cntrl = True
    $ flower_collected.append(flower)
    window hide
    if len(flower_collected) < 9:
        $ lock_plyr_cntrl = False
        $ flower = None
    else:
        show screen maid_end
        $ flower = None
    $ renpy.pause(modal=False,hard=True)

screen maid_screen:
    default m_s = [
        {"name":"FLOWER 1","pos":(580,80), "targ_pos":(582,175)},
        {"name":"FLOWER 2","pos":(220,100), "targ_pos":(295,196)},
        {"name":"FLOWER 3","pos":(220,700), "targ_pos":(294,769)},
        {"name":"FLOWER 4","pos":(690,920), "targ_pos":(672,999)},
        {"name":"FLOWER 5","pos":(1135,360), "targ_pos":(1153,456)},
        {"name":"FLOWER 6","pos":(1505,560), "targ_pos":(1490,623)},
        {"name":"FLOWER 7","pos":(1525,760), "targ_pos":(1511,854)},
        {"name":"FLOWER 8","pos":(770,100), "targ_pos":(816,180)},
        {"name":"FLOWER 9","pos":(1260,150), "targ_pos":(1253,222)},
    ]
    for i in m_s:
        if i["name"] not in flower_collected:
            imagebutton:
                idle Transform("RF/example images/buttons/area_3a.png",zoom=0.05)
                hover Transform("RF/example images/buttons/area_3b.png",zoom=0.05)
                xpos i["pos"][0] ypos i["pos"][1]
                action [SetVariable("flower",i["name"]),Function(follower.set_button_destination, i["targ_pos"][0],i["targ_pos"][1], follower.route.lines)]

    add Transform(Solid("#000000"),xysize=(175,100)) alpha 0.75 xalign 0.5
    hbox:
        xalign 0.5
        add Transform("RF/example images/buttons/area_3a.png",zoom=0.05)
        text str(len(flower_collected)) size 75 color "#FFFFFF" outlines [ (5, "#000000", 1.5, 1.5) ] xalign 0.5 yalign 0.25

