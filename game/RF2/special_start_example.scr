################################################################################
## BOARD GAME EXAMPLE ## IMAGE = 1 Angles // -- [O] Free Movement // [O] Action Points
################################################################################






screen board_end:
    modal True
    zorder 1
    add Solid("#000000") alpha 0.95
    text "YOU WON THE GAME!" size 50 color "#FFFFFF" xalign 0.5 yalign 0.5 yoffset -75
    vbox:
        xalign 0.5 yalign 0.5
        textbutton _("RESTART") text_idle_color "#36A839" text_hover_color "#5AFF49" xalign 0.5 yalign 0.5 action [Function(follower.set_teleport, 633,722, follower.route.lines),Hide("board_end")]
        textbutton _("END") text_idle_color "#36A839" text_hover_color "#5AFF49" xalign 0.5 yalign 0.5 action [MainMenu()]

label board_end:
    $ lock_plyr_cntrl = True
    $ follower.set_destination(1288, 399, BOARD_MAP)
    show screen board_end
    window hide
    $ lock_plyr_cntrl = False
    $ renpy.pause(modal=False,hard=True)

label board_event_1: ## EXAMPLE OF SWITCHING ROUTES MID GAME
    $ lock_plyr_cntrl = True
    $ follower.pause_follower()
    menu:
        "You landed on a shortcut space"
        "Take Shortcut":
            $ follower.stop_follower()
            $ load_predefined_route(rl, BOARD_MAP2)
            $ follower.set_destination(960, 425, BOARD_MAP2)
            $ renpy.pause(0.5,modal=False,hard=True)
            $ load_predefined_route(rl, BOARD_MAP)
        "Nah I'll Pass":
            $ follower.play_follower()
    window hide
    $ lock_plyr_cntrl = False
    $ renpy.pause(modal=False,hard=True)

label board_event_2: ## EXAMPLE OF SWITCHING ROUTES MID GAME
    $ lock_plyr_cntrl = True
    $ follower.pause_follower()
    menu:
        "You landed on a shortcut space"
        "Take Shortcut":
            $ follower.stop_follower()
            $ load_predefined_route(rl, BOARD_MAP2)
            $ follower.set_destination(1289, 513, BOARD_MAP2)
            $ renpy.pause(0.5,modal=False,hard=True)
            $ load_predefined_route(rl, BOARD_MAP)
        "Nah I'll Pass":
            $ follower.play_follower()
    window hide
    $ lock_plyr_cntrl = False
    $ renpy.pause(modal=False,hard=True)

label board_event_3: ## EXAMPLE OF SWITCHING ROUTES MID GAME
    $ lock_plyr_cntrl = True
    $ follower.pause_follower()
    menu:
        "Uh Oh you landed on a Backup Space"
        "Go Back":
            $ follower.stop_follower()
            $ load_predefined_route(rl, BOARD_MAP2)
            $ follower.set_destination(956, 608, BOARD_MAP2)
            $ renpy.pause(0.5,modal=False,hard=True)
            $ load_predefined_route(rl, BOARD_MAP)
        "Nah I'll Pass":
            $ follower.play_follower()
    window hide
    $ lock_plyr_cntrl = False
    $ renpy.pause(modal=False,hard=True)

screen board_screen:
    default m_s = [
        {"name":"FINISH","pos":(1218,364), "targ_pos":(1218,364)},
    ]
    for i in m_s:
        imagebutton:
            idle Transform("RF/example images/buttons/area_0a.png",zoom=0.5)
            hover Transform("RF/example images/buttons/area_0a.png",zoom=0.5)
            xpos i["pos"][0] ypos i["pos"][1]
            action [Function(follower.set_reach,"board_end"),Function(follower.set_button_destination, i["targ_pos"][0],i["targ_pos"][1], follower.route.lines)]

default BOARD_MAP = [
    {'points': [[633, 722], [634, 422], [655, 380], [692, 360], [736, 359], [775, 384], [795, 424], [796, 655], [816, 695], [852, 717], [899, 715], [939, 695], [958, 652], [960, 423], [980, 380], [1018, 358], [1063, 358], [1102, 383], [1122, 422], [1125, 654], [1141, 692], [1177, 715], [1228, 717], [1267, 693], [1287, 655], [1288, 399]], 'color': '#FF0000', 'editing': False, 'connected': False}
]
default BOARD_MAP2 = [
    {'points': [[799, 517], [960, 425]], 'color': '#FF0000', 'editing': False, 'connected': False},
    {'points': [[1122, 651], [956, 608]], 'color': '#FF0000', 'editing': False, 'connected': False},
    {'points': [[1121, 474], [1289, 513]], 'color': '#FF0000', 'editing': False, 'connected': False}
]
default board_interact_points = [
    {'name': 'point_1', 'point': (795.3982609347476, 515.9982759266894), 'label': 'board_event_1', 'active': True, 'detected': False},
    {'name': 'point_2', 'point': (1122.5586164620215, 465.1996730629911), 'label': 'board_event_2', 'active': True, 'detected': False},
    {'name': 'point_3', 'point': (1124.9376962086453, 649.181840135233), 'label': 'board_event_3', 'active': True, 'detected': False},
    {'name': 'point_4', 'point': (1287.8596975754153, 434.917420693654), 'label': 'board_end', 'active': True, 'detected': False}
]




################################################################################
## FANTASY EXAMPLE ## IMAGE = 4 Angles // -- [X] Free Movement // [O] Action Points
################################################################################






default fantasy_city = None
default fantasy_level = 1
default fantasy_story = 0

screen fantasy_win:
    modal True
    zorder 1
    add Solid("#000000") alpha 0.95
    text "YOU SAVED THE REALM!" size 50 color "#FFFFFF" xalign 0.5 yalign 0.5 yoffset -75
    vbox:
        xalign 0.5 yalign 0.5
        textbutton _("RESTART") text_idle_color "#36A839" text_hover_color "#5AFF49" xalign 0.5 yalign 0.5 action [SetVariable("lock_plyr_cntrl",False),SetVariable("map_cutscene",False),SetVariable("fantasy_city",True),Function(follower.togg_interact_point,'point_1',True),Function(follower.set_teleport, 986,540, follower.route.lines),Hide("fantasy_win")]
        textbutton _("END") text_idle_color "#36A839" text_hover_color "#5AFF49" xalign 0.5 yalign 0.5 action [MainMenu()]

screen fantasy_lose:
    modal True
    zorder 1
    add Solid("#000000") alpha 0.95
    text "GAME OVER!" size 50 color "#FFFFFF" xalign 0.5 yalign 0.5 yoffset -75
    vbox:
        xalign 0.5 yalign 0.5
        textbutton _("RESTART") text_idle_color "#36A839" text_hover_color "#5AFF49" xalign 0.5 yalign 0.5 action [SetVariable("lock_plyr_cntrl",False),SetVariable("map_cutscene",False),SetVariable("fantasy_city",True),Function(follower.togg_interact_point,'point_1',True),Function(follower.set_teleport, 986,540, follower.route.lines),Hide("fantasy_lose")]
        textbutton _("END") text_idle_color "#36A839" text_hover_color "#5AFF49" xalign 0.5 yalign 0.5 action [MainMenu()]

label fantasy_win:
    $ lock_plyr_cntrl = True
    show screen fantasy_win
    window hide
    $ renpy.pause(modal=False,hard=True)

label fantasy_lose:
    $ lock_plyr_cntrl = True
    show screen fantasy_lose
    window hide
    $ renpy.pause(modal=False,hard=True)

label fantasy_area_0:
    $ map_cutscene = True
    $ lock_plyr_cntrl = True
    "You travel to [fantasy_city]."
    "There is nothing to do here."
    window hide
    $ map_cutscene = False
    $ lock_plyr_cntrl = False
    $ fantasy_city = None
    $ renpy.pause(modal=False,hard=True)

label fantasy_area_combat:
    $ map_cutscene = True
    $ lock_plyr_cntrl = True
    "You travel to [fantasy_city]."
    "There is nothing to do here."
    window hide
    $ map_cutscene = False
    $ lock_plyr_cntrl = False
    $ fantasy_city = None
    $ renpy.pause(modal=False,hard=True)

label fantasy_area_cs:
    $ map_cutscene = True
    $ lock_plyr_cntrl = True
    "You travel to [fantasy_city]."
    if fantasy_story == 0:
        "Your group enters the castle. You all kneel at the kings throne."
        "Greetings. What do you want? The kings asks."
        menu:
            "Ask for kings help":
                "'We are looking for able warriors to aid us in defeating the bandit army' your group asks."
                "Uhhh sure, here."
                "He hands you a napkin with his signature on it"
                "Kings Signature acquired!"
                if fantasy_level < 9:
                    "The king stops you before leaving."
                    "You sould also go to Lunareth Spire, you guys are looking under prepared to fight off bandits. That is all"
                else:
                    "The king stops you before leaving."
                    "I dont even see why you three even need help, yall can handle yourselves"
                $ fantasy_story = 1
            "Uh nothing":
                "I mean alright get outta here then."
    else:
        "You wander around the cities surrounding the castle. Its a very wholesome scene."
        "You decide theres nothing else to do here and leave."
    window hide
    $ map_cutscene = False
    $ lock_plyr_cntrl = False
    $ fantasy_city = None
    $ renpy.pause(modal=False,hard=True)

label fantasy_area_ls:
    $ map_cutscene = True
    $ lock_plyr_cntrl = True
    "You travel to [fantasy_city]."
    "The quartermaster sits there picking his teeth"
    "Aye, what brings you here?"
    jump fantasy_area_ls2
label fantasy_area_ls2:
    menu:
        "Current Level: [fantasy_level] - (TRAINING)":
            if fantasy_level >= 1 and fantasy_level <= 3:
                "You begin training"
                "Your team is exhausted by the little training done"
            elif fantasy_level >= 4 and fantasy_level <= 5:
                "You begin training"
                "Your team trained a little more today"
            elif fantasy_level >= 6 and fantasy_level <= 7:
                "You begin training"
                "Your team barely broke a sweat"
            elif fantasy_level >= 8 and fantasy_level <= 9:
                "You begin training"
                "Your team is stronger than ever"
            else:
                "You begin training"
                "Your team can now annihilate armies with just you three."
            "You rest for a while"
            $ fantasy_level += 1
            jump fantasy_area_ls2
        "(LEAVE)":
            "You decide that you are prepared enough."
    window hide
    $ map_cutscene = False
    $ lock_plyr_cntrl = False
    $ fantasy_city = None
    $ renpy.pause(modal=False,hard=True)

default fantasy_if = 0
label fantasy_area_if:
    $ map_cutscene = True
    $ lock_plyr_cntrl = True
    $ follower.stop_follower() ## STOPS FOLLOWER MID TRACKS
    if fantasy_if == 0:
        "OY, what do you want? a man screams from atop the blockade wall on the road before the fort."
        menu:
            "We need your help" if fantasy_story == 0:
                "Many need our, help, but we take orders only from the king!"
                "Go to Castle Stormcrag n ask the king to give ye a note as proof!"
                "IGHT THEN *BEEP* OFF!"
                "You are taken aback by the rude nature of the man, and turn around and leave."
                $ fantasy_if = 1
                $ follower.set_destination(1121.0083737329219, 548.2230057293962, follower.route.lines)
                window hide
                $ renpy.pause(0.35,modal=False,hard=True)
            "We need your help (Show Napkin)" if fantasy_story > 0:
                "Many need our, help, but we take orders only from the king!"
                "You show the napkin with the kings signature"
                "ALRIGHT ALRIGHT WELL GO!"
                "He whistles"
                "His whole army marches towards the bandit camp"
                "Well meet you at the Ashenmoor Camp"
                "They march ahead"
                $ fantasy_if = 2
                $ fantasy_story = 2
                $ renpy.pause(0.35,modal=False,hard=True)
            "You will help us or well make you help us! (INTIMIDATE)" if fantasy_level < 5:
                "OY YOU *BEEEEEEP* Thats it!"
                "He jumps down and sizes up to you"
                "HAH! he laughs YOU ARE ALL JUST WEEE BABIES COMPARED TO MEH!"
                "He quickly deals with your group leaving you unconscious!"
                "As you are in a deep slumber the bandit camp rampages from city to city conquering the land."
                jump fantasy_lose
            "You will help us or well make you help us! (INTIMIDATE)" if fantasy_level > 5:
                "OY YOU *BEEEEEEP* Thats it!"
                "He jumps down and sizes up to you"
                "He sees your group prepare for battle, making him flinch."
                "ALRIGHT ALRIGHT WELL GO!"
                "He whistles"
                "His whole army marches towards the bandit camp"
                "Well meet you at the Ashenmoor Camp"
                "They march ahead"
                $ fantasy_if = 2
                $ fantasy_story = 2
            "Uh nothing":
                "IGHT THEN *BEEP* OFF!"
                "You are taken aback by the rude nature of the man, and turn around and leave."
                $ follower.set_destination(1121.0083737329219, 548.2230057293962, follower.route.lines)
                window hide
                $ renpy.pause(0.35,modal=False,hard=True)
    elif fantasy_if == 1:
        "OY, did ye get the note?!."
        menu:
            "YES" if fantasy_story > 0:
                "You show the napkin with the kings signature"
                "ALRIGHT ALRIGHT WELL GO!"
                "He whistles"
                "His whole army marches towards the bandit camp"
                "Well meet you at the Ashenmoor Camp"
                "They march ahead"
                $ fantasy_if = 2
                $ fantasy_story = 2
            "YES (LIE)" if fantasy_story < 0:
                "YOU LYIN *BEEEP* *BEEEEEEEEEEEEP* *BEEP* I COULD COME DOWN THERE AND *BEEEEP* YOUR HEAD OFF. NOW *BEEP* OFF BEFORE I DO!"
                "You are taken aback by the rude nature of the man, and turn around and leave."
                $ follower.set_destination(1121.0083737329219, 548.2230057293962, follower.route.lines)
                window hide
            "You will help us or well make you help us! (INTIMIDATE)" if fantasy_level < 5 and fantasy_story < 0:
                "OY YOU *BEEEEEEP* Thats it!"
                "He jumps down and sizes up to you"
                "HAH! he laughs YOU ARE ALL JUST WEEE BABIES COMPARED TO MEH!"
                "He quickly deals with your group leaving you unconscious!"
                "As you are in a deep slumber the bandit camp rampages from city to city conquering the land."
                jump fantasy_lose
            "You will help us or well make you help us! (INTIMIDATE)" if fantasy_level > 5 and fantasy_story < 0:
                "OY YOU *BEEEEEEP* Thats it!"
                "He jumps down and sizes up to you"
                "He sees your group prepare for battle, making him flinch."
                "ALRIGHT ALRIGHT WELL GO!"
                "He whistles"
                "His whole army marches towards the bandit camp"
                "Well meet you at the Ashenmoor Camp"
                "They march ahead"
                $ fantasy_if = 2
                $ fantasy_story = 2
            "NO":
                "IGHT THEN *BEEP* OFF!"
                "You are taken aback by the rude nature of the man, and turn around and leave."
                $ follower.set_destination(1121.0083737329219, 548.2230057293962, follower.route.lines)
                window hide
                $ renpy.pause(0.35,modal=False,hard=True)
    else:
        "You travel to [fantasy_city]."
        "You explore the empty camp."
        "You decide theres nothing else to do here and leave."

    if fantasy_story == 2:
        $ follower.togg_interact_point('point_1',False)
    window hide
    $ map_cutscene = False
    $ lock_plyr_cntrl = False
    $ fantasy_city = None
    $ renpy.pause(modal=False,hard=True)

label fantasy_area_abc:
    $ map_cutscene = True
    $ lock_plyr_cntrl = True
    "You approach the bandit camp, a man see you."
    "A thousand men, walk out of the camp grounds, you only have seconds to decide what todo"
    menu:
        "FIGHT!(WITH ARMY)" if fantasy_story == 2:
            "You scream charge as your group and the newly acquried army run towards the bandits."
            "The battle takes a while."
            "As their forces dwindle, eventually the battle ends, you and the men cheer lifting up your tankers of ale in the air."
            jump fantasy_win
        "FIGHT!(JUST YOU THREE)" if fantasy_level > 9:
            "Your group is well equipped, you decide that your group can handle this just you three"
            "You raise your sword and charge the bandits"
            "As you slaughter their men, you realize that you mightve taken training a little too seriously."
            "As their forces dwindle, eventually the battle ends, you and your group cheer lifting up your tankers of ale in the air."
            jump fantasy_win
        "FIGHT!" if fantasy_story < 2 and fantasy_level < 10:
            "Your group thinks they are well equipped, you decide that your group can handle this just you three"
            "You raise your sword and charge the bandits"
            " - "
            "You wake up, you are wounded beyond belief and your group has parished"
            "You slowly fade into the darkness wondering if you shouldve prepared more."
            jump fantasy_lose
        "RUNAWAY":
            "Your wits get the best of you and decide to flee"
            $ follower.set_destination(1032, 598, follower.route.lines)
            window hide
            $ renpy.pause(0.5,modal=False,hard=True)
    window hide
    $ map_cutscene = False
    $ lock_plyr_cntrl = False
    $ fantasy_city = None
    $ renpy.pause(modal=False,hard=True)

transform fantasy_text:
    on start:
        alpha 0.0
        linear 0.15 alpha 1.0

screen fantasy_screen:
    default m_s = [
        {"name":"Eldergrove Peak","pos":(980,128), "targ_pos":(998,240),"label":'fantasy_area_0'},
        {"name":"Castle Stormcrag","pos":(780,208), "targ_pos":(836,331),"label":'fantasy_area_cs'},
        {"name":"Ashenmoor Bandit Camp","pos":(1035,655), "targ_pos":(1022,717),"label":'fantasy_area_abc'},
        {"name":"Starfall Vale Observatory","pos":(580,375), "targ_pos":(619,495),"label":'fantasy_area_0'},
        {"name":"Whispering Willows","pos":(1100,240), "targ_pos":(1150,353),"label":'fantasy_area_0'},
        {"name":"Ironfang Hold","pos":(1255,556), "targ_pos":(1245,624),"label":'fantasy_area_if'},
        {"name":"Lunareth Spire","pos":(1415,410), "targ_pos":(1408,476),"label":'fantasy_area_ls'},
    ]
    default fantasy_areas = None
    if fantasy_areas != None:
        text "[fantasy_areas]" xalign 0.5 yoffset 25 at fantasy_text
    for i in m_s:
        if not map_cutscene:
            imagebutton:
                idle Transform("RF/example images/buttons/area_1a.png",zoom=0.15)
                hover Transform("RF/example images/buttons/area_1b.png",zoom=0.15)
                xpos i["pos"][0] ypos i["pos"][1]
                hovered SetScreenVariable("fantasy_areas",i['name'])
                unhovered SetScreenVariable("fantasy_areas",None)
                ## PLAYER CAN CLICK OTHER POINTS MID ROUTE TO REDIRECT TO THAT NEW POINT ##
                action [SetVariable("fantasy_city",i["name"]),Function(follower.set_reach,i['label']),SetVariable("lock_plyr_cntrl",True),Function(follower.set_button_destination, i["targ_pos"][0],i["targ_pos"][1], follower.route.lines)]
        else:
            add  Transform("RF/example images/buttons/area_1a.png",zoom=0.15) xpos i["pos"][0] ypos i["pos"][1]

