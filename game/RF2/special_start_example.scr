## SCRIPT EXAMPLES ##
################################################################################
## TEST STUFF ##
################################################################################
default map_select = "RF/example images/maps/map4.png"
default map_size = 0.25
default map_yoff = 0
default map_screens = "board"
################################################################################
## IMG LIB
################################################################################
##////////////////////////////////////////////////////////////////////////////##
##////////////////////////////////////////////////////////////////////////////##
## THIS IS AN EXAMPLE OF A 1 ANGLED IMAGE ## - use with self.directional_mode = '1'
default piece_lib = {
                    "stand": {"image":Transform("RF/example images/chars/piece.png",zoom=0.05), "AT":0.1, "xoff":-3,"yoff":18}, ## STAND
                    "idle": {"image":Transform("RF/example images/chars/piece.png",zoom=0.05), "AT":0.1, "xoff":-3,"yoff":18}, ## STAND

                }
##////////////////////////////////////////////////////////////////////////////##
##////////////////////////////////////////////////////////////////////////////##
## THIS IS AN EXAMPLE OF A FREE ANGLED IMAGE ## - use with self.directional_mode = 'free'
default car_lib = {
                    "stand": {"image":Transform("RF/example images/chars/car.png",zoom=0.20), "AT":0.1, "xoff":0,"yoff":0}, ## STAND
                    "idle": {"image":Transform("RF/example images/chars/car.png",zoom=0.20), "AT":0.1, "xoff":0,"yoff":0}, ## STAND

                }
