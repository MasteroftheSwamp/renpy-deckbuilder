################################################################################
## CYBERPUNK EXAMPLE ## IMAGE = Free Angles// -- [X] Free Movement // [O] Action Points
################################################################################






default cyberpunk_city = None
screen cyberpunk_end:
    modal True
    zorder 1
    add Solid("#000000") alpha 0.95
    text "YOU FOUND HER!" size 50 color "#FFFFFF" xalign 0.5 yalign 0.5 yoffset -75
    vbox:
        xalign 0.5 yalign 0.5
        textbutton _("RESTART") text_idle_color "#36A839" text_hover_color "#5AFF49" xalign 0.5 yalign 0.5 action [SetVariable("lock_plyr_cntrl",False),SetVariable("aoi",None),SetVariable("areas_visited",[]),SetVariable("items",['lipstick','jacket','cellphone','scrunchie','earring','diary','bracelet']),SetVariable("map_cutscene",False),SetVariable("cyberpunk_city",True),Function(follower.set_teleport, 1036,533, follower.route.lines),Hide("cyberpunk_end")]
        textbutton _("END") text_idle_color "#36A839" text_hover_color "#5AFF49" xalign 0.5 yalign 0.5 action [MainMenu()]

default items = ['lipstick','jacket','cellphone','scrunchie','earring','diary','bracelet']
default areas_visited = []
default aoi = None ## area of interest example
label cyberpunk_end:
    $ lock_plyr_cntrl = True
    show screen cyberpunk_end
    window hide
    $ lock_plyr_cntrl = False
    $ cyberpunk_city = None
    $ renpy.pause(modal=False,hard=True)

label cyberpunk_area:
    $ lock_plyr_cntrl = True
    "You reach your destination: [cyberpunk_city]"
    if aoi == cyberpunk_city:
        "{i} Detective you are in the area she was last seen"
        "You look around with a flashlight and find a hidden bar"
        "You walk into the hidden bar, and find her at the barstool"
        "Beaten and bruised . . . but alive"
        "She has an unlit cigarette in her mouth"
        "You reach in your pocket and pull out your lighter"
        "You light her cigarette"
        "She smiles and asks {i}Who are you?"
        "You tell her"
        "{i}Your old man sent me, hes been worried"
        "She smiles and hugs you"
        "{i}Thank you . . . they wouldnt let me leave so I had to escape and hide"
        "Shes been through alot, but shell be safe and sound now"
        jump cyberpunk_end
    else:
        menu:
            "Scan Area":
                jump cyberpunk_collect
            "Leave":
                "You leave the area"
    window hide
    $ lock_plyr_cntrl = False
    $ cyberpunk_city = None
    $ renpy.pause(modal=False,hard=True)

label cyberpunk_collect:
    "You pull out your Eye-Drone, It starts to scan the area"
    "{cps=15} . . . "
    $ rand_item = renpy.random.choice(items)
    $ items.remove(rand_item)
    "You found an item: [rand_item] acquired"
    $ areas_visited.append(cyberpunk_city)
    if len(items) == 0:
        "You realize you have all the evidence necessary"
        "You load all the items into your vehicles evidence terminal"
        "It scans all the clues"
        "{cps=15} . . . "
        "The computer finds the location you need to head to . . ."
        $ rand_locale = renpy.random.choice(areas_visited)
        $ aoi = rand_locale
        if aoi == cyberpunk_city:
            "{i} Detective you are in the area she was last seen"
            "You look around with a flashlight and find a hidden bar"
            "You walk into the hidden bar, and find her at the barstool"
            "Beaten and bruised . . . but alive"
            "She has an unlit cigarette in her mouth"
            "You reach in your pocket and pull out your lighter"
            "You light her cigarette"
            "She smiles and asks {i}Who are you?"
            "You tell her"
            "{i}Your old man sent me, hes been worried"
            "She smiles and hugs you"
            "{i}Thank you . . . they wouldnt let me leave so I had to escape and hide"
            "Shes been through alot, but shell be safe and sound now"
            jump cyberpunk_end
        else:
            "{i} Detective you must head to [rand_locale]"
            "The computer adds the location to the gps"
    else:
        "You hop in your car and plot your next route for the next location of investigation"
    window hide
    $ lock_plyr_cntrl = False
    $ cyberpunk_city = None
    $ renpy.pause(modal=False,hard=True)



screen cyberpunk_screen:
    default m_s = [
        {"name":"Neon Sprawl","pos":(370,935), "targ_pos":(375,993),},
        {"name":"Chrome District","pos":(695,725), "targ_pos":(687,774),},
        {"name":"Rustbelt Slums","pos":(883,955), "targ_pos":(897,1020),},
        {"name":"Synthgrid","pos":(750,120), "targ_pos":(790,181),},
        {"name":"Bladepoint","pos":(1370,180), "targ_pos":(1378,237),},
        {"name":"Data Abyss","pos":(1190,480), "targ_pos":(1190,530),},
        {"name":"Ion Verge","pos":(1515,506), "targ_pos":(1558,488),},
    ]
    for i in m_s:
        if i['name'] == aoi:
            imagebutton:
                idle Transform("RF/example images/buttons/area_2a.png",zoom=0.65)
                hover Transform("RF/example images/buttons/area_2b.png",zoom=0.65)
                xpos i["pos"][0] ypos i["pos"][1]
                ## PLAYER MUST WAIT FOR FOLLOWER TO REACH POINT ##
                action [SetVariable("cyberpunk_city",i["name"]),Function(follower.set_reach,"cyberpunk_area"),SetVariable("lock_plyr_cntrl",True),Function(follower.set_button_destination, i["pos"][0],i["pos"][1], follower.route.lines)]
        else:
            if i['name'] not in areas_visited:
                if cyberpunk_city:
                    add Transform("RF/example images/buttons/area_2a.png",zoom=0.65) xpos i["pos"][0] ypos i["pos"][1]
                else:
                    imagebutton:
                        idle Transform("RF/example images/buttons/area_2a.png",zoom=0.65)
                        hover Transform("RF/example images/buttons/area_2b.png",zoom=0.65)
                        xpos i["pos"][0] ypos i["pos"][1]
                        ## PLAYER MUST WAIT FOR FOLLOWER TO REACH POINT ##
                        action [SetVariable("cyberpunk_city",i["name"]),Function(follower.set_reach,"cyberpunk_area"),SetVariable("lock_plyr_cntrl",True),Function(follower.set_button_destination, i["pos"][0],i["pos"][1], follower.route.lines)]


