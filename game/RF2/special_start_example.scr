################################################################################
## SCREEN EXAMPLE ##
################################################################################
transform map_show:
    on start:
        alpha 0.0
        linear 0.15 alpha 1.0
transform map_hide:
    on start:
        alpha 1.0
        linear 0.15 alpha 0.0
default map_cutscene = False ## STOPS IMAGE BUTTONS FROM BEING PRESSED IN A CUTSCENE EXAMPLE
screen special_example_screens:
    zorder 0
    default follower_show = True

    add map_select xalign 0.5 yalign 0.5 zoom map_size yoffset map_yoff

    if map_screens == "board":
        use board_screen
    elif map_screens == "fantasy":
        use fantasy_screen
    elif map_screens == "maid":
        use maid_screen
    if map_screens == "cyberpunk":
        use cyberpunk_screen

    add rl

    if follower_show:
        add follower
    vbox:
        xalign 1.0
        yalign 0.0
        textbutton _("Show follower // [follower_show]") text_idle_color "#2B5DBC" text_hover_color "#00FFFF" xalign 1.0:
            if follower_show:
                action SetScreenVariable("follower_show",False)
            else:
                action SetScreenVariable("follower_show",True)
        textbutton _("DevMode// [dev_mode]//") text_idle_color "#36A839" text_hover_color "#5AFF49" action ToggleVariable("dev_mode",true_value=True,false_value=False) xalign 1.0
        textbutton _("Main Menu") action MainMenu() text_idle_color "#2B5DBC" text_hover_color "#00FFFF" xalign 1.0

################################################################################
## SCREEN EXAMPLE ##
################################################################################


################################################################################
## EXAMPLE JUMP ##
################################################################################

label special_start_example:
    menu:
        "BOARD GAME":
            $ map_select = "RF/example images/maps/map4.png"
            $ map_size = 0.5
            $ map_yoff = 0
            $ map_screens = "board"

            $ follower.load_interact_points(board_interact_points)
            $ load_predefined_route(rl, BOARD_MAP)

            $ follower.img_id = piece_lib
            $ follower.turn = False
            $ follower.speed = 400
            $ follower.directional_mode = "1"
            $ follower.set_teleport (633,722,follower.route.lines)
            $ follower.reset_follower()

            "You open an old box with a board game you used to play with your family"
            "You start to reminisce about those good old days"

        "FANTASY GAME":
            $ map_select = "RF/example images/maps/map2.png"
            $ map_size = 0.25
            $ map_yoff = 0
            $ map_screens = "fantasy"

            $ follower.load_interact_points(fantasy_interact_points)
            $ load_predefined_route(rl, FANTASY_MAP)

            $ follower.img_id = squad_lib
            $ follower.turn = True
            $ follower.speed = 200
            $ follower.directional_mode = "4"
            $ follower.free_movement = False
            $ follower.set_teleport (986,540,follower.route.lines)
            $ follower.reset_follower()

            "You and your group of adventurers have been scouting a bandit camp, growing in numbers"
            "Seeing that they have plans of seizing the realm under their thumbs"
            "You and your group decide to do something about it . . ."

        "MAID GAME":
            $ map_select = "RF/example images/maps/map5.png"
            $ map_size = 0.5
            $ map_yoff = 250
            $ map_screens = "maid"

            $ flower = None
            $ flower_collected = []

            $ load_predefined_route(rl, MAID_MAP)

            menu:
                "Would you like to use the independent horizontal images test? (Turn off auto flip image)"
                "Yes! Turn off auto flip! (follower.turn = False)":
                    $ follower.turn = False
                    $ follower.img_id = maid2_lib
                    "Ok look at the maids eyes to see it work!"
                "No! Keep auto flip on! (follower.turn = True)":
                    $ follower.turn = True
                    $ follower.img_id = maid_lib
                    "Ok the maid will use a mirrored horizontal images!"
            $ follower.speed = 200
            $ follower.directional_mode = "8"
            $ follower.set_reach("maid_flower_collected")
            $ follower.set_teleport (1040,650,follower.route.lines)
            $ follower.reset_follower()

            "YAY! Todays a special day!"
            "Its your daughters birthday!"
            "You remember your daughter talking about wanting flowers, so you spend your free day gathering flowers for her celebration."

        "CYBERPUNK GAME":
            $ map_select = "RF/example images/maps/map3.png"
            $ map_size = 0.65
            $ map_yoff = 0
            $ map_screens = "cyberpunk"

            $ load_predefined_route(rl, CYBERPUNK_MAP)

            $ follower.img_id = car_lib
            $ follower.turn = True
            $ follower.speed = 400
            $ follower.directional_mode = "free"
            $ follower.free_movement = False
            $ follower.set_teleport (1036,533,follower.route.lines)
            $ follower.reset_follower()

            "Youre a detective. You are driving around looking for clues about a missing girl."
            "She was seen at each location through out the week."
            "Times ticking . . ."

    window hide
    show screen special_example_screens
    $ renpy.pause(modal=False,hard=True)

